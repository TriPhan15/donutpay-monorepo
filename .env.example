# Mẫu file .env cho docker compose (máy dev và server EC2). Sao chép thành .env rồi điền giá trị thật:
#   cp .env.example .env && nano .env
# KHÔNG commit file .env (đã có trong .gitignore). Hướng dẫn chi tiết: docs/deploy/DEPLOY_GUIDE.md

# ---- Môi trường ----
# prod trên EC2 (bắt buộc JWT_SECRET, tắt Swagger), dev trên máy cá nhân.
SPRING_PROFILES_ACTIVE=prod
# Tên miền mà Caddy xin chứng chỉ HTTPS, vd. api.example.com. Để trống trên máy dev (chỉ HTTP cổng 80).
SITE_ADDRESS=

# ---- Bảo mật ----
# Khóa ký JWT, ít nhất 32 ký tự. Tạo bằng: openssl rand -base64 48
# Đổi khóa = mọi người dùng phải đăng nhập lại.
JWT_SECRET=

# ---- PostgreSQL ----
# DB_URL do docker-compose.yml đặt sẵn (db:5432); chỉ cần khi chạy core-backend ngoài Docker.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ---- Redis (bắt buộc) ----
REDIS_PASSWORD=

# ---- MongoDB (bắt buộc; chỉ dùng chữ và số vì mật khẩu nằm trong URI) ----
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ---- Cloudinary (ảnh hóa đơn) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Gmail SMTP (gửi OTP quên mật khẩu; dùng App Password) ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Đăng nhập Google ----
GOOGLE_WEB_CLIENT_ID=
# App ID Facebook (công khai, = facebook_app_id trong strings.xml của mobile-app). Trống thì đăng nhập Facebook bị từ chối.
FACEBOOK_APP_ID=1631447635348542

# ---- Thanh toán (demo) ----
PAYMENT_SECRET=
MOCK_GATEWAY_URL=
PAYMENT_WEBHOOK_URL=
VNPAY_SECRET=
ZALOPAY_SECRET=

# ---- Dữ liệu demo (Config/DataSeeder) ----
# Lần deploy đầu trên database trống: true. Hai mật khẩu: 8-72 ký tự, có chữ và số.
SEED_DEMO=false
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
