# Mẫu file .env cho docker compose (máy dev và server EC2). Sao chép thành .env rồi điền giá trị thật:
#   cp .env.example .env && nano .env
# KHÔNG commit file .env (đã có trong .gitignore). Hướng dẫn chi tiết: docs/deploy/DEPLOY_GUIDE.md

# ---- Môi trường ----
# prod trên EC2 (bắt buộc JWT_SECRET, tắt Swagger), dev trên máy cá nhân.
SPRING_PROFILES_ACTIVE=prod
# Tên miền mà Caddy xin chứng chỉ HTTPS, vd. api.example.com. Để trống trên máy dev (chỉ HTTP cổng 80).
SITE_ADDRESS=

# ---- Bảo mật ----
# Khóa ký JWT, ít nhất 32 ký tự. Tạo bằng: openssl rand -base64 48
# Đổi khóa = mọi người dùng phải đăng nhập lại.
JWT_SECRET=

# ---- PostgreSQL ----
# DB_URL do docker-compose.yml đặt sẵn (db:5432); chỉ cần khi chạy core-backend ngoài Docker.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ---- Redis (bắt buộc) ----
REDIS_PASSWORD=

# ---- MongoDB (bắt buộc; chỉ dùng chữ và số vì mật khẩu nằm trong URI) ----
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# ---- Elasticsearch (tìm kiếm giao dịch; tùy chọn) ----
# postgres (mặc định): không dùng Elasticsearch. elasticsearch: cần chạy profile search:
#   docker compose --profile search up -d
# Chỉ mục được tạo và nạp tự động lúc khởi động lần đầu và sau mỗi lần restore; dựng lại bằng tay: POST /api/admin/search/reindex
SEARCH_ENGINE=postgres
# Mật khẩu của user elastic (core-api và healthcheck dùng). Chỉ bắt buộc khi chạy với --profile search.
# Để trống: stack mặc định không bị ảnh hưởng, nhưng healthcheck của elasticsearch (và Kibana) sẽ thất bại.
ELASTIC_PASSWORD=
# Mật khẩu của user kibana_system cho Kibana (profile tools). Đặt MỘT LẦN sau khi elasticsearch đã chạy:
#   docker compose --profile search exec elasticsearch sh -c 'curl -s -u "elastic:$ELASTIC_PASSWORD" -X POST localhost:9200/_security/user/kibana_system/_password -H "Content-Type: application/json" -d "{\"password\":\"<KIBANA_PASSWORD>\"}"'
# ($ELASTIC_PASSWORD được đọc bên trong container; thay <KIBANA_PASSWORD> bằng cùng giá trị với KIBANA_PASSWORD bên dưới; kết quả đúng là {})
# Không dùng bin/elasticsearch-reset-password: công cụ đó mở thêm một JVM và đã làm Elasticsearch bị OOM-kill ở 1 GiB.
# Rồi: docker compose --profile search --profile tools up -d
KIBANA_PASSWORD=

# ---- Cloudinary (ảnh hóa đơn) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Gmail SMTP (gửi OTP quên mật khẩu; dùng App Password) ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Đăng nhập Google ----
GOOGLE_WEB_CLIENT_ID=

# ---- Thanh toán (demo) ----
PAYMENT_SECRET=
MOCK_GATEWAY_URL=
PAYMENT_WEBHOOK_URL=
VNPAY_SECRET=
ZALOPAY_SECRET=

# ---- Dữ liệu demo (Config/DataSeeder) ----
# Lần deploy đầu trên database trống: true. Hai mật khẩu: 8-72 ký tự, có chữ và số.
SEED_DEMO=false
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
