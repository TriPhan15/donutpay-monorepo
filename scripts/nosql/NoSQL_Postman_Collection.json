                "app-dashboard"
              ]
            },
            "description": "Gọi hai lần: lần đầu đọc PostgreSQL và ghi key ledgermind:<env>:v1:user-dashboard:<userId>; lần hai đọc từ Redis (nhìn thời gian phản hồi và `GET` / `TTL` ở redis-cli)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "[CACHE] Q-19 Các cửa hàng phổ biến (cache user-popular-vendors)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/popular-vendors",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions",
                "popular-vendors"
              ]
            },
            "description": "Cache theo user, xóa khi người dùng đó thay đổi giao dịch."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "[OTP] Q-17 Gửi OTP quên mật khẩu (lưu hash Redis, TTL 5 phút)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password?email={{userEmail}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "forgot-password"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{userEmail}}"
                }
              ]
            },
            "description": "email là query parameter (không phải JSON). Tạo key ledgermind:password-reset-otp:<email> với PEXPIRE; mã được gửi qua email."
          }
        },
        {
          "name": "[OTP] Q-27 Đặt lại mật khẩu bằng OTP (kiểm tra nguyên tử bằng Lua)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Phản hồi 200 hoặc 400 (sai/hết hạn OTP)', () => pm.expect([200, 400]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"DoiMatKhau@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
