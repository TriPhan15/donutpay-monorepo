{
  "info": {
    "_postman_id": "ledgermind-nosql-collection-v2",
    "name": "LedgerMind - NoSQL API Collection",
    "description": "Bộ API cho đồ án NoSQL: MongoDB (OCR), Redis (cache, OTP, bảng xếp hạng), Elasticsearch (tìm kiếm). Mỗi request ghi rõ truy vấn Q-xx tương ứng trong scripts/nosql.\n\nCách dùng:\n1. Điền các biến của collection: baseUrl, adminEmail, adminPassword, userEmail, userPassword.\n2. Chạy folder 1. Auth (token tự lưu vào jwtToken / userToken).\n3. Chạy các folder còn lại. Endpoint /api/admin/** dùng jwtToken (ROLE_ADMIN); tìm kiếm và cache của người dùng dùng userToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "feedbackId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Đăng nhập admin (token vào {{jwtToken}}) và người dùng thường (token vào {{userToken}}). Điền adminPassword / userPassword ở tab Variables. Tài khoản demo: bật SEED_DEMO=true cho core-api, admin có email admin@example.com.",
      "item": [
        {
          "name": "Login admin -> jwtToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('jwtToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login người dùng -> userToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('userToken', pm.response.json().data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. MongoDB - OCR (ocr_logs, ocr_feedbacks)",
      "description": "Tất cả endpoint /api/admin/** cần ROLE_ADMIN (dùng {{jwtToken}}). Truy vấn MongoDB tương ứng: mongodb_demo.js, Q-01 ... Q-16.",
      "item": [
        {
          "name": "[READ] Q-01 Danh sách nhật ký OCR thô (ocr_logs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/ocr-logs?page=0&size=10&sort=createdAt,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "ocr-logs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "createdAt,desc"
                }
              ]
            },
            "description": "Phân trang theo Pageable của Spring. Mỗi phần tử có transactionId, rawJsonData, averageConfidenceScore, createdAt."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "[READ] Q-03/Q-04 Danh sách phản hồi OCR (lọc theo trường, trạng thái, khoảng ngày)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/ocr-feedbacks?field=total_cost&resolved=false&from=2026-08-01&to=2026-10-31&page=0&size=20&sort=reportedAt,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "ocr-feedbacks"
              ],
              "query": [
                {
                  "key": "field",
                  "value": "total_cost"
                },
                {
                  "key": "resolved",
                  "value": "false"
                },
                {
                  "key": "from",
                  "value": "2026-08-01"
                },
                {
                  "key": "to",
                  "value": "2026-10-31"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "sort",
                  "value": "reportedAt,desc"
                }
              ]
            },
            "description": "field = seller_name | total_cost | receipt_date; resolved = true|false; from/to dạng yyyy-MM-dd (gồm cả ngày to); sort = reportedAt|updatedAt kèm ,asc|,desc. Mọi tham số đều tùy chọn."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json().data;",
                  "if (page && page.content && page.content.length) { pm.collectionVariables.set('feedbackId', page.content[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "[UPDATE] Q-07 Đánh dấu phản hồi đã xử lý",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/ocr-feedbacks/{{feedbackId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "ocr-feedbacks",
                "{{feedbackId}}",
                "resolve"
              ]
            },
            "description": "feedbackId lấy tự động từ request danh sách phía trên. 404 nếu id không tồn tại."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "[AGGREGATE] Q-10..Q-12, Q-15 Thống kê chất lượng OCR",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/ocr-feedbacks/analytics?from=2026-08-01&to=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "ocr-feedbacks",
                "analytics"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2026-08-01"
                },
                {
                  "key": "to",
                  "value": "2026-10-31"
                }
              ]
            },
            "description": "Trả errorsByField, errorsByModel, confidenceByMonth, receiptsWithErrorRate trong [from, to]; bỏ from/to để lấy toàn bộ."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Có đủ 4 nhóm thống kê', () => pm.expect(d).to.include.keys('errorsByField', 'errorsByModel', 'confidenceByMonth', 'receiptsWithErrorRate'));"
                ]
              }
            }
          ]
        },
        {
          "name": "[DELETE] Q-08 Xóa một phản hồi OCR",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/ocr-feedbacks/{{feedbackId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "ocr-feedbacks",
                "{{feedbackId}}"
              ]
            },
            "description": "Chạy cuối cùng: xóa phản hồi có id trong {{feedbackId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Redis - cache, OTP, bảng xếp hạng",
      "description": "Truy vấn Redis tương ứng: redis_demo.txt, Q-17 ... Q-29. Bảng xếp hạng là Sorted Set ledgermind:leaderboard:spend:yyyy-MM.",
      "item": [
        {
          "name": "[ZSET] Q-23 Bảng xếp hạng chi tiêu tháng (Top spenders)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/leaderboard?month=2026-10&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "leaderboard"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-10"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "month dạng yyyy-MM (mặc định: tháng hiện tại), limit 1..50 (mặc định 10). Lần đầu của một tháng: dựng từ PostgreSQL rồi ghi vào Redis; các lần sau đọc ZREVRANGE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data;",
                  "pm.test('Xếp giảm dần theo totalSpent', () => { for (let i = 1; i < rows.length; i++) pm.expect(Number(rows[i-1].totalSpent)).to.be.at.least(Number(rows[i].totalSpent)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "[ZSET] Q-22 Dựng lại bảng xếp hạng một tháng từ PostgreSQL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/leaderboard/rebuild?month=2026-10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "leaderboard",
                "rebuild"
              ],
              "query": [
                {
                  "key": "month",
                  "value": "2026-10"
                }
              ]
            },
            "description": "Xóa key của tháng rồi ZADD lại từ PostgreSQL; trả số user trong bảng."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "[CACHE] Q-19 Dashboard người dùng - lần 1 (MISS) rồi lần 2 (HIT)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/app-dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
