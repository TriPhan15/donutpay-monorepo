@startuml
!pragma layout smetana
!include _style.iuml
skinparam NodeBackgroundColor white
skinparam ArtifactBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam linetype ortho

node "Điện thoại Android" as PHONE {
  artifact "APK ứng dụng LedgerMind" as APK
}
node "Máy tính quản trị viên" as PC {
  artifact "Trình duyệt web" as BR
}
node "GitHub" as GH {
  artifact "GitHub Actions\nbackend-ci, mobile-ci, ai-ci\ndeploy, release-apk" as CI
}

node "Máy ảo AWS EC2 (Ubuntu Server)" as EC2 {
  node "Docker Engine – mạng finance-network (bridge)" as DOCKER {
    node "proxy\ncaddy:2.8-alpine\ncổng 80, 443 (công khai)" as PROXY
    node "core-api\neclipse-temurin:21-jre\ncổng 8080 (nội bộ), 512 MB" as CORE
    node "data-mining-api\npython:3.10-slim\ncổng 8000 (nội bộ), 1 GB" as AI
    database "db\npostgres:15-alpine\n127.0.0.1:5432" as PG
    database "redis\nredis:8.10-alpine\nkhông mở cổng" as RD
    database "mongodb\nmongo:6.0\n127.0.0.1:27017" as MG
  }
}

APK --> PROXY : HTTPS
BR --> PROXY : HTTPS
CI --> EC2 : SSH: git reset, docker compose up
PROXY --> CORE : HTTP
PROXY --> AI : HTTP /ai/*
CORE --> AI : HTTP
CORE --> PG
CORE --> RD
CORE --> MG
@enduml
