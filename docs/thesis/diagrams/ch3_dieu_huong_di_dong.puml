@startuml
' Hình 3.5: Sơ đồ điều hướng giữa các màn hình của ứng dụng di động
!pragma layout smetana
!include _style.iuml
skinparam RectangleBackgroundColor white
skinparam defaultFontSize 15
top to bottom direction

rectangle "LoginScreen\n(Đăng nhập)" as LOGIN
rectangle "RegisterScreen" as REG
rectangle "ForgotPasswordScreen" as FORGOT
rectangle "ResetPasswordScreen" as RESET
rectangle "MainScaffold\n(thanh điều hướng 4 tab + nút Quét AI)" as MAIN
rectangle "DashboardPage\n(Trang chủ)" as DASH
rectangle "LedgerPage\n(tab Thống kê,\ntiêu đề Sổ sách)" as LEDGER
rectangle "AITabPage\n(tab AI)" as AI
rectangle "ProfilePage\n(Cá nhân)" as PROFILE
rectangle "ReviewFormPage\n(Xác nhận hóa đơn)" as REVIEW
rectangle "AddTransactionPage\nEditTransactionPage" as TX
rectangle "BudgetScreen" as BUDGET
rectangle "NotificationScreen" as NOTI
rectangle "SavingsPage" as SAV
rectangle "SettingsScreen\nAccountInfoScreen\nLinkedServicesPage" as SET

LOGIN --> REG
LOGIN --> FORGOT
FORGOT --> RESET
RESET --> LOGIN
LOGIN --> MAIN
MAIN --> DASH
MAIN --> LEDGER
MAIN --> AI
MAIN --> PROFILE
MAIN --> REVIEW
LEDGER --> TX
DASH --> BUDGET
DASH --> NOTI
DASH --> SAV
PROFILE --> SET
PROFILE --> BUDGET
@enduml
