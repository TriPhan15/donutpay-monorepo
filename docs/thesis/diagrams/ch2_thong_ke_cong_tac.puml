@startuml ch2_thong_ke_cong_tac
' Hình 2.13: Sơ đồ cộng tác quy trình thống kê và báo cáo thói quen chi tiêu (mục 2.2.5); số thứ tự trùng Hình 2.12
!include _style.iuml
!pragma layout smetana
actor "Người dùng" as ND
rectangle ":Ứng dụng di động" as APP
rectangle ":Core Backend" as BE
rectangle ":AI Service" as AI
rectangle ":Giao dịch" as GD
rectangle ":Mục tiêu tiết kiệm" as MT
ND -- APP : "1: Mở Tổng quan ↓\n↑ 6: Hiển thị Tổng quan\n7: Mở tab AI ↓\n↑ 16: Mẫu chi tiêu và gợi ý"
APP -- APP : "5: Tính số dư, tổng thu chi"
APP -- BE : "2: Lấy hồ sơ, giao dịch, ngân sách ↓\n↑ 4: Hồ sơ, giao dịch, ngân sách\n8: Lấy giao dịch và mục tiêu ↓\n↑ 10: Giao dịch và mục tiêu"
BE -- GD : "3: Đọc giao dịch ↓"
BE -- MT : "9: Đọc mục tiêu ↓"
APP -- AI : "11: Gửi giao dịch trong khoảng ↓\n↑ 13: Các mẫu chi tiêu\n14: [có mục tiêu] Gửi giao dịch và mục tiêu ↓\n↑ 15: Xu hướng, gợi ý"
AI -- AI : "12: Khai phá mẫu chuỗi"
@enduml
