@startuml ch3_thong_ke_tuan_tu
!include _style.iuml
hide footbox
autonumber
skinparam defaultFontSize 13
skinparam BoundaryBackgroundColor white
skinparam ControlBackgroundColor white
skinparam EntityBackgroundColor white
actor "Người dùng" as ND
boundary ":AITabPage" as UI
control ":App\nRepository" as REPO
boundary ":RemoteApi\nHelper" as API
control ":Transaction\nService" as TS
control ":AI Service" as AI
control ":WCMSpade" as WS
ND -> UI ++ : Mở tab AI, chọn\nkhoảng thời gian
UI -> REPO ++ : getTransactions(userId)
REPO -> TS ++ : GET\n/api/transactions/mine
return danh sách\nTransactionResponseDto
return List<TransactionModel>
UI -> API ++ : fetchSavings()
return mục tiêu tiết kiệm\n(GET /api/savings)
UI -> UI : lọc theo khoảng,\ntính tổng thu chi,\nbiểu đồ tuần
UI -> API ++ : analyzePatterns(giao\ndịch trong khoảng)
API -> AI ++ : POST /spade/analyze
AI -> WS ++ : mine(sequences,\nitem_prices)
return các mẫu chuỗi có\ntrọng số
return patterns
return
UI -> API ++ : recommendBudget(giao\ndịch, mục tiêu)
API -> AI ++ : POST\n/spade/recommend
return xu hướng, gợi ý ngân\nsách
return
UI --> ND -- : Hiển thị thẻ phân\ntích và gợi ý
@enduml
