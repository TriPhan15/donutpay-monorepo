@startuml erd_khai_niem
' ERD khái niệm (facts.md 1.1, 1.3, 1.4); nét đứt = liên kết logic giữa các CSDL (bằng id, không có khóa ngoại)
!pragma layout smetana
!include _style.iuml
hide circle
hide members
skinparam wrapWidth 160
title ERD khái niệm (kèm CSDL chứa thực thể)
entity "Người dùng\n[PostgreSQL]" as U
entity "Giao dịch\n[PostgreSQL]" as T
entity "Danh mục\n[PostgreSQL]" as C
entity "Hóa đơn\n[PostgreSQL]" as R
entity "Lần đọc AI\n[PostgreSQL]" as A
entity "Ngân sách\n[PostgreSQL]" as B
entity "Thông báo\n[PostgreSQL]" as N
entity "Log OCR thô\n[MongoDB]" as L
entity "Phản hồi OCR\n[MongoDB]" as F
entity "Tài liệu tìm kiếm\n[Elasticsearch]" as S
entity "Bảng xếp hạng tháng\n[Redis]" as Z
U ||--o{ T : ghi
C ||--o{ T : phân loại
T |o--o| R : kèm
R ||--o{ A : có
U ||--o{ B : đặt
C |o--o{ B : áp dụng cho
U ||--o{ N : nhận
T |o..o| L : transactionId
R ||..o{ F : receiptId
T ||..|| S : id
U ||..o| Z : member userId
@enduml
